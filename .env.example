# RSS 每日摘要配置示例
# 复制本文件为 .env 并填入你的真实配置：cp .env.example .env

# ---- Web 服务 ----
# 监听端口
PORT=3002
# 监听地址，默认仅本机访问。若需局域网/外网访问改为 0.0.0.0（请自行加认证）
HOST=127.0.0.1

# 设置访问令牌：配置后，"设置"（源管理/调度/手工生成）需通过
#   http://localhost:3002/?token=你的令牌   访问，否则设置不可见、相关接口返回 401。
# 留空则设置不加保护（任何人可访问，仅建议本机使用）。
# 生成一个随机令牌：node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
SETTINGS_TOKEN=

# ---- DeepSeek API（可选）----
# 用于将文章摘要翻译成中文。不配置则仅截断原文到 300 字，不翻译。
# 获取地址: https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# ---- 邮件配置（可选）----
# 不配置则只保存摘要，不发送邮件。
# EMAIL_PASS 是邮箱的 SMTP 授权码，不是登录密码。
# 端口 465 自动启用 SSL，其他端口使用 STARTTLS。
EMAIL_HOST=smtp.qq.com
EMAIL_PORT=465
EMAIL_USER=your-email@qq.com
EMAIL_PASS=your-smtp-authorization-code
EMAIL_TO=recipient@example.com
